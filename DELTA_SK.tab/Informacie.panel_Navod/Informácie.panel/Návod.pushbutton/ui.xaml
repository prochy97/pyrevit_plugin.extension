        <Button x:Name="close_b" DockPanel.Dock="Bottom" HorizontalAlignment="Right"
                Content="Zavrieť" MinWidth="90" Padding="10,3" Margin="0,8,0,0" IsCancel="True"/>
        <TabControl x:Name="tabs"/>
    </DockPanel>
</Window>
