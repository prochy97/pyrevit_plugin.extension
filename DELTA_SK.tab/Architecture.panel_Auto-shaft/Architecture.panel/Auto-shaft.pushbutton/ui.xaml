<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Auto-shaft" Width="1040" Height="760" MinWidth="900" MinHeight="640"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="3,1"/>
        </Style>
        <Style x:Key="Poznamka" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,4,0,0">
            <Button x:Name="start_b" Content="Štart" MinWidth="90" FontWeight="Bold" IsDefault="True"/>
            <Button x:Name="cancel_b" Content="Zrušiť" MinWidth="90" IsCancel="True"/>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="430"/>
            </Grid.ColumnDefinitions>

            <!-- ĽAVÝ STĹPEC -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0" Header="1. Rodina otvoru">
                    <ComboBox x:Name="family_cb"/>
                </GroupBox>

                <GroupBox Grid.Row="1" Header="2. Výber konštrukcií">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBlock Text="Filter názvu:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Button x:Name="none_b" Content="Žiadne" DockPanel.Dock="Right"/>
                            <Button x:Name="all_b" Content="Všetky" DockPanel.Dock="Right"/>
                            <Button x:Name="filter_b" Content="Označiť podľa filtra" DockPanel.Dock="Right"/>
                            <TextBox x:Name="filter_tb"/>
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Poznamka}"
                                   Text="Typy konštrukcií z aktívneho view, do ktorých sa vytvorí otvor. Viac výrazov vo filtri oddeľ bodkočiarkou, napr. RCO;ZB. Výber sa dá upraviť ručne."/>
                        <Border BorderBrush="#FFBBBBBB" BorderThickness="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="walls_sp" Margin="4"/>
                            </ScrollViewer>
                        </Border>
                    </DockPanel>
                </GroupBox>

                <GroupBox Grid.Row="2" Header="3. Linky profesií">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Poznamka}"
                                   Text="Rozbaľ kategóriu a vyber linky, z ktorých sa majú robiť otvory. Zobrazujú sa len linky, ktoré majú danú kategóriu viditeľnú v aktívnom view."/>
                        <Border BorderBrush="#FFBBBBBB" BorderThickness="1">
                            <TreeView x:Name="tree" BorderThickness="0" Padding="2"/>
                        </Border>
                    </DockPanel>
                </GroupBox>
            </Grid>

            <!-- PRAVÝ STĹPEC -->
            <StackPanel Grid.Column="2">
                <GroupBox Header="4. Odsadenie otvoru [mm]">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <RadioButton x:Name="uniform_rb" Content="Jednotné odsadenie" GroupName="mode"
                                         VerticalAlignment="Center" Width="160"/>
                            <TextBox x:Name="uniform_tb" Width="70"/>
                        </StackPanel>
                        <RadioButton x:Name="per_rb" Content="Odsadenie podľa kategórie" GroupName="mode"
                                     Margin="0,0,0,6"/>
                        <Grid Margin="18,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Pipes" VerticalAlignment="Center"/>
                            <TextBox x:Name="pipes_tb" Grid.Row="0" Grid.Column="1" Margin="0,2"/>
                            <TextBlock Grid.Row="1" Text="Ducts" VerticalAlignment="Center"/>
                            <TextBox x:Name="ducts_tb" Grid.Row="1" Grid.Column="1" Margin="0,2"/>
                            <TextBlock Grid.Row="2" Text="Cable Trays" VerticalAlignment="Center"/>
                            <TextBox x:Name="trays_tb" Grid.Row="2" Grid.Column="1" Margin="0,2"/>
                            <TextBlock Grid.Row="3" Text="Conduits" VerticalAlignment="Center"/>
                            <TextBox x:Name="conduits_tb" Grid.Row="3" Grid.Column="1" Margin="0,2"/>
                        </Grid>
                        <DockPanel Margin="0,10,0,0">
                            <TextBox x:Name="mindn_tb" Width="70" DockPanel.Dock="Right"/>
                            <TextBlock Text="Neosádzať pre potrubia menšie ako DN"
                                       VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Poznamka}"
                                   Text="Odsadenie sa meria od vonkajšieho povrchu prvku vrátane izolácie. Rozmer otvoru zaokrúhlený nahor na 10 mm. Pri šikmom prechode sa berie celý pretiahnutý prienik so stenou. Limit DN sa posudzuje podľa svetlosti potrubia bez izolácie."/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="5. Dodatočné informácie">
                    <StackPanel>
                        <DockPanel Margin="0,2">
                            <TextBox x:Name="gap_tb" Width="70" DockPanel.Dock="Right"/>
                            <TextBlock Text="Spojiť otvory, ak medzi nimi ostane menej steny ako [mm]"
                                       VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </DockPanel>
                        <DockPanel Margin="0,2">
                            <TextBox x:Name="limit_tb" Width="70" DockPanel.Dock="Right"/>
                            <TextBlock Text="Označiť otvory väčšie ako (šírka, výška) [mm]"
                                       VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Poznamka}"
                                   Text="Spájajú sa nové aj existujúce otvory na tej istej stene (existujúce len pri zapnutej kontrole). Pri medzere 0 sa spájajú len prekrývajúce sa otvory."/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="6. Typ akcie">
                    <StackPanel>
                        <CheckBox x:Name="new_cb" Margin="0,2" Content="Osadiť nové otvory"/>
                        <CheckBox x:Name="check_cb" Margin="0,2" Content="Skontrolovať existujúce otvory"/>
                        <CheckBox x:Name="update_cb" Margin="18,2,0,2"
                                  Content="Upraviť posunuté, zmenené a spájané otvory"/>
                        <CheckBox x:Name="delete_cb" Margin="18,2,0,2"
                                  Content="Zmazať otvory bez kolízie alebo so zmazaným prvkom"/>
                        <TextBlock Style="{StaticResource Poznamka}"
                                   Text="Kontrolujú sa otvory na stenách viditeľných v aktívnom view. Pred zápisom do modelu sa zobrazí súhrn: Vykonať / Len report / Zrušiť."/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
