<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YIT – TALO kódy podľa EIR" Width="1450" Height="880"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="12">
    <Window.Resources>
        <Style x:Key="TypeRow" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding status}" Value="OK">
                    <Setter Property="Background" Value="#E2F0D9"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding status}" Value="Nesúlad">
                    <Setter Property="Background" Value="#F8D7D5"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CodeRow" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding has_warning}" Value="True">
                    <Setter Property="Background" Value="#FFF2CC"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- horná lišta -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="True">
            <TextBlock Text="Kategória:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="cb_category" Width="200" SelectionChanged="on_category_changed"/>
            <CheckBox x:Name="chk_all_codes" Content="Zobraziť všetky kódy" Margin="14,0,0,0"
                      VerticalAlignment="Center" Click="on_filter_changed"/>
            <TextBlock Text="Hľadať kód:" VerticalAlignment="Center" Margin="14,0,6,0"/>
            <TextBox x:Name="tb_search" Width="180" TextChanged="on_filter_changed"/>
            <Button x:Name="btn_pick" Content="Vybrať prvky v modeli…" Margin="14,0,0,0"
                    Padding="10,2" Click="on_pick"/>
            <Button x:Name="btn_clear_pick" Content="Zrušiť výber" Margin="6,0,0,0"
                    Padding="10,2" Click="on_clear_pick"/>
            <TextBlock x:Name="tb_info" VerticalAlignment="Center" HorizontalAlignment="Right"
                       Margin="14,0,0,0" Foreground="#555"/>
        </DockPanel>

        <!-- kódy | typy -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="Kódy z EIR" FontWeight="Bold" Margin="0,0,0,4"/>
                <DataGrid x:Name="dg_codes" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" HeadersVisibility="Column"
                          RowStyle="{StaticResource CodeRow}" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#DDD">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Rozsah" Binding="{Binding rozsah}" Width="105"/>
                        <DataGridTextColumn Header="Skr." Binding="{Binding oz}" Width="40"/>
                        <DataGridTextColumn Header="Popis" Binding="{Binding popis}" Width="2*"/>
                        <DataGridTextColumn Header="IFC" Binding="{Binding ifc}" Width="90"/>
                        <DataGridTextColumn Header="1_Kategoria" Binding="{Binding kategoria}" Width="110"/>
                        <DataGridTextColumn Header="Revit kat." Binding="{Binding kat_text}" Width="*"/>
                        <DataGridTextColumn Header="Upozornenie" Binding="{Binding upozornenie}" Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"/>

            <DockPanel Grid.Column="2">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <TextBlock Text="Typy v projekte" FontWeight="Bold" VerticalAlignment="Center"/>
                    <ComboBox x:Name="cb_status" Width="110" Margin="12,0,0,0"
                              SelectionChanged="on_filter_changed"/>
                    <CheckBox x:Name="chk_only_picked" Content="Len z výberu" Margin="12,0,0,0"
                              VerticalAlignment="Center" Click="on_filter_changed"/>
                    <TextBlock Text="Hľadať:" VerticalAlignment="Center" Margin="12,0,6,0"/>
                    <TextBox x:Name="tb_search_types" TextChanged="on_filter_changed"/>
                </DockPanel>
                <DataGrid x:Name="dg_types" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Extended" HeadersVisibility="Column"
                          RowStyle="{StaticResource TypeRow}" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#DDD">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Stav" Binding="{Binding status}" Width="70"/>
                        <DataGridTextColumn Header="Kód" Binding="{Binding kod_text}" Width="80"/>
                        <DataGridTextColumn Header="Názov typu" Binding="{Binding name}" Width="2*"/>
                        <DataGridTextColumn Header="Rodina" Binding="{Binding family}" Width="*"/>
                        <DataGridTextColumn Header="Kategória" Binding="{Binding category_key}" Width="100"/>
                        <DataGridTextColumn Header="Inšt." Binding="{Binding count}" Width="45"/>
                        <DataGridTextColumn Header="Vybr." Binding="{Binding picked}" Width="45"/>
                        <DataGridTextColumn Header="Dôvod nesúladu" Binding="{Binding reasons_text}" Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>

        <!-- akcia -->
        <DockPanel Grid.Row="2" Margin="0,8">
            <Button x:Name="btn_preview" Content="Pripraviť náhľad ▼" Padding="14,4" Click="on_preview"
                    FontWeight="Bold"/>
            <CheckBox x:Name="chk_duplicate" Content="Ak je vybraná len časť inštancií typu, duplikovať typ"
                      IsChecked="True" Margin="14,0,0,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="tb_hint" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="#555"
                       Text="Vľavo vyber kód, vpravo jeden alebo viac typov."/>
        </DockPanel>

        <!-- náhľad -->
        <DockPanel Grid.Row="3">
            <TextBlock DockPanel.Dock="Top" Text="Náhľad zmien (stĺpec Nový názov sa dá upraviť)"
                       FontWeight="Bold" Margin="0,0,0,4"/>
            <DataGrid x:Name="dg_preview" AutoGenerateColumns="False" CanUserAddRows="False"
                      CanUserDeleteRows="True" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#DDD">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Akcia" Binding="{Binding action}" Width="110" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Starý názov" Binding="{Binding old_name}" Width="2*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Nový názov" Binding="{Binding new_name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
                    <DataGridTextColumn Header="1_Kod_prvku" Binding="{Binding code}" Width="85" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Assembly" Binding="{Binding talo}" Width="65" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Type Mark" Binding="{Binding tag}" Width="75" IsReadOnly="True"/>
                    <DataGridTextColumn Header="IFC" Binding="{Binding ifc}" Width="90" IsReadOnly="True"/>
                    <DataGridTextColumn Header="1_Kategoria" Binding="{Binding kategoria}" Width="110" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Poznámka" Binding="{Binding note}" Width="*" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <!-- spodná lišta -->
        <DockPanel Grid.Row="4" Margin="0,8,0,0" LastChildFill="False">
            <Button Content="Export kódov do CSV…" Padding="10,4" Click="on_export"/>
            <Button Content="Zavrieť" DockPanel.Dock="Right" Padding="14,4" Margin="6,0,0,0" Click="on_close"/>
            <Button x:Name="btn_apply" Content="Zapísať do modelu" DockPanel.Dock="Right" Padding="14,4"
                    FontWeight="Bold" Click="on_apply"/>
            <Button Content="Vyčistiť náhľad" DockPanel.Dock="Right" Padding="10,4" Margin="0,0,6,0"
                    Click="on_clear_preview"/>
        </DockPanel>
    </Grid>
</Window>
