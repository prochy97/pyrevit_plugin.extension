<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Auto-shaft" Width="560" Height="930" MinWidth="460" MinHeight="720"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="3,1"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,4,0,0">
            <Button x:Name="start_b" Content="Štart" MinWidth="90" FontWeight="Bold" IsDefault="True"/>
            <Button x:Name="cancel_b" Content="Zrušiť" MinWidth="90" IsCancel="True"/>
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Rodina -->
            <GroupBox Grid.Row="0" Header="1. Rodina otvoru">
                <ComboBox x:Name="family_cb"/>
            </GroupBox>

            <!-- 2. Typy stien -->
            <GroupBox Grid.Row="1" Header="2. Typy stien, ktoré sa majú rezať (z aktívneho view)">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock Text="Filter názvu:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Button x:Name="none_b" Content="Žiadne" DockPanel.Dock="Right"/>
                        <Button x:Name="all_b" Content="Všetky" DockPanel.Dock="Right"/>
                        <Button x:Name="filter_b" Content="Označiť podľa filtra" DockPanel.Dock="Right"/>
                        <TextBox x:Name="filter_tb"/>
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" Margin="0,4,0,0" FontSize="11" Foreground="Gray"
                               Text="Viac výrazov oddeľ bodkočiarkou, napr. RCO;ZB. Výber sa dá upraviť ručne."/>
                    <Border BorderBrush="#FFBBBBBB" BorderThickness="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="walls_sp" Margin="4"/>
                        </ScrollViewer>
                    </Border>
                </DockPanel>
            </GroupBox>

            <!-- 3. Linky -->
            <GroupBox Grid.Row="2" Header="3. Linky profesií (zapnuté v aktívnom view)">
                <ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="links_sp"/>
                </ScrollViewer>
            </GroupBox>

            <!-- 4. Profesie a odstup -->
            <GroupBox Grid.Row="3" Header="4. Profesie a odstup otvoru na každú stranu [mm]">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <RadioButton x:Name="uniform_rb" Content="Jednotný odstup" GroupName="mode"
                                     VerticalAlignment="Center" Width="140"/>
                        <TextBox x:Name="uniform_tb" Width="70"/>
                    </StackPanel>
                    <RadioButton x:Name="per_rb" Content="Odstup podľa profesie" GroupName="mode"
                                 Margin="0,0,0,6"/>
                    <Grid Margin="18,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <CheckBox x:Name="pipes_cb" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"
                                  Margin="0,2" Content="Potrubia (ZTI, ÚK, chladenie)"/>
                        <TextBox x:Name="pipes_tb" Grid.Row="0" Grid.Column="1" Margin="0,2"/>
                        <CheckBox x:Name="vzt_cb" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"
                                  Margin="0,2" Content="VZT"/>
                        <TextBox x:Name="vzt_tb" Grid.Row="1" Grid.Column="1" Margin="0,2"/>
                        <CheckBox x:Name="ele_cb" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"
                                  Margin="0,2" Content="Elektro (žľaby, chráničky)"/>
                        <TextBox x:Name="ele_tb" Grid.Row="2" Grid.Column="1" Margin="0,2"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Neosádzať pre potrubia a chráničky menšie ako DN"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="mindn_tb" Width="60"/>
                    </StackPanel>
                    <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                               Text="0 = otvory aj pre najmenšie potrubia. Rozhoduje svetlosť potrubia (DN), nie izolácia; rozmer otvoru izoláciu zahŕňa."/>
                </StackPanel>
            </GroupBox>

            <!-- 5. Akcie -->
            <GroupBox Grid.Row="4" Header="5. Čo urobiť">
                <StackPanel>
                    <CheckBox x:Name="new_cb" Margin="0,2" Content="Osadiť nové otvory"/>
                    <CheckBox x:Name="check_cb" Margin="0,2"
                              Content="Skontrolovať existujúce otvory v aktívnom view"/>
                    <CheckBox x:Name="update_cb" Margin="18,2,0,2"
                              Content="Upraviť posunuté a zmenené otvory"/>
                    <CheckBox x:Name="delete_cb" Margin="18,2,0,2"
                              Content="Zmazať otvory bez kolízie alebo so zmazaným prvkom"/>
                    <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                               Text="Pred zápisom do modelu sa zobrazí súhrn: Vykonať / Len report / Zrušiť."/>
                </StackPanel>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
